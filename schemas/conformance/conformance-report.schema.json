{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bionexus.org/schemas/conformance/conformance-report.schema.json",
  "title": "BioNexus Conformance Test Report Schema",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "suite_version",
    "candidate",
    "summary",
    "dimension_scores",
    "profile_evaluations",
    "results",
    "integrity_digest",
    "badge_eligible",
    "certification_effect"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bns.conformance-report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^BNS-REP-[0-9]{4}-[A-Za-z0-9_-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "candidate": {
      "type": "object",
      "required": ["name", "version", "target_type", "target_content_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target_type": {"type": "string", "minLength": 1},
        "target_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_environment": {"type": "object"}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total_cases",
        "passed_cases",
        "failed_cases",
        "critical_failures",
        "overall_score",
        "diagnostic_tier"
      ],
      "properties": {
        "total_cases": {"type": "integer", "minimum": 0},
        "passed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0},
        "critical_failures": {"type": "integer", "minimum": 0},
        "overall_score": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "diagnostic_tier": {
          "type": "string",
          "enum": ["GOLD", "SILVER", "BRONZE", "NON_CONFORMANT"]
        }
      },
      "additionalProperties": false
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["total", "passed", "score_percent", "status"],
        "properties": {
          "total": {"type": "integer", "minimum": 0},
          "passed": {"type": "integer", "minimum": 0},
          "score_percent": {"type": "number", "minimum": 0.0, "maximum": 100.0},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_ASSESSED"]}
        },
        "additionalProperties": false
      }
    },
    "profile_evaluations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "passed_dimensions", "failed_dimensions"],
        "properties": {
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
          "passed_dimensions": {
            "type": "array",
            "items": {"type": "string"}
          },
          "failed_dimensions": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "dimension", "severity", "passed"],
        "properties": {
          "case_id": {"type": "string"},
          "dimension": {"type": "string"},
          "severity": {"type": "string"},
          "passed": {"type": "boolean"},
          "details": {"type": "string"},
          "failure_code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "integrity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "badge_eligible": {
      "type": "boolean"
    },
    "certification_effect": {
      "type": "string",
      "enum": ["NONE", "ASSESSED_BY_INDEPENDENT_CAB", "DIAGNOSTIC_ONLY"]
    }
  },
  "additionalProperties": false
}
